#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_config {
            bindings = <&tog 5>;
            key-positions = <5 4>;
        };

        esc_combo {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    behaviors {
        crtl_win: crtl_win {
            compatible = "zmk,behavior-tap-dance";
            label = "CRTL_WIN";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LCMD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            bindings = <
&kp Q         &kp W        &kp E        &kp R  &kp T    &kp Y  &kp U  &kp I      &kp O    &kp P
&mt LSHIFT A  &kp S        &mt LCTRL D  &kp F  &kp G    &kp H  &kp J  &kp K      &kp L    &mt RIGHT_SHIFT SEMICOLON
&mt LCTRL Z   &kp X        &kp C        &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_WIN  &lt 1 SPACE                                                        &mo 3    &mo 4
            >;
        };

        num {
            bindings = <
&kp N1     &kp N2    &kp N3     &kp N4   &kp N5     &kp N6         &kp N7  &kp N8  &kp N9  &kp N0
&kp LSHFT  &kp LALT  &kp LCTRL  &kp TAB  &kp DEL    &kp BACKSPACE  &trans  &trans  &trans  &trans
&trans     &trans    &trans     &trans   &trans     &kp CAPS       &trans  &trans  &trans  &kp ENTER
&trans     &trans                                                                  &mo 2   &trans
            >;
        };

        func {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7   &kp F8   &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans    &trans  &kp F11  &kp F12  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans   &trans   &trans  &trans
&trans  &trans                                                      &trans  &trans
            >;
        };

        sym {
            bindings = <
&trans     &trans  &trans  &trans  &trans        &trans         &trans     &trans     &kp BSLH      &kp SQT
&kp LSHFT  &trans  &trans  &trans  &kp DELETE    &kp BACKSPACE  &kp MINUS  &kp EQUAL  &kp LS(LPAR)  &kp LS(RPAR)
&trans     &trans  &trans  &trans  &trans        &trans         &kp GRAVE  &kp LBKT   &kp RBKT      &kp RET
&trans     &trans                                                                     &trans        &trans
            >;
        };

        nav {
            bindings = <
&kp TAB    &trans    &trans     &trans   &trans     &kp INSERT  &kp HOME  &kp PAGE_DOWN  &kp F9  &kp END
&kp LSHFT  &kp LALT  &kp LCTRL  &kp TAB  &kp DEL    &kp BSPC    &kp LEFT  &kp DOWN       &kp UP  &kp RIGHT
&trans     &trans    &trans     &trans   &trans     &kp K_MENU  &trans    &trans         &trans  &kp ENTER
&trans     &trans                                                                        &trans  &none
            >;
        };

        config {
            bindings = <
&none         &none         &none         &none         &none           &none  &none  &none  &none  &none
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none
&none         &none         &none         &none         &none           &none  &none  &none  &none  &bt BT_CLR
&none         &none                                                                          &none  &none
            >;
        };
    };
};
